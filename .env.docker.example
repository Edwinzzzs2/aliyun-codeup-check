# 可选：替换为版本标签，例如 ghcr.io/edwinzzzs2/aliyun-codeup-check:v1.0.0
CODEUP_IMAGE=ghcr.io/edwinzzzs2/aliyun-codeup-check:latest
APP_PORT=3000

# 必填：Supabase 服务端配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 必填：定时监听在服务端运行，Token 需要 Codeup 只读和流水线运行实例读写权限
CODEUP_TOKEN=your-yunxiao-personal-access-token
CODEUP_ORG_ID=5f9a23913a5188f27f3f344b

# 可选：保护流水线 Cron 接口
CRON_SECRET=
YUNXIAO_OPENAPI_BASE_URL=https://openapi-rdc.aliyuncs.com
ENABLE_INTERNAL_PIPELINE_SCHEDULER=true

# 可选：CodeUp 服务端代理
CODEUP_PROXY_URL=
CODEUP_PROXY_TOKEN=
