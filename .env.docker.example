# 可选：替换为版本标签，例如 ghcr.io/edwinzzzs2/aliyun-codeup-check:v1.0.0
CODEUP_IMAGE=ghcr.io/edwinzzzs2/aliyun-codeup-check:latest
APP_PORT=3000

# 必填：Supabase 服务端配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 可选：CodeUp 服务端代理
CODEUP_PROXY_URL=
CODEUP_PROXY_TOKEN=
